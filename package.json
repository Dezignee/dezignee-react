{
  "name": "@dezignee/react",
  "version": "0.1.2",
  "description": "React component that embeds the Dezignee document editor in your product",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dezignee/dezignee-react.git"
  },
  "homepage": "https://github.com/Dezignee/dezignee-react#readme",
  "bugs": {
    "url": "https://github.com/Dezignee/dezignee-react/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && vite build",
    "build:example": "vite build --config example/vite.config.ts"
  },
  "peerDependencies": {
    "dezignee-plugin": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dezignee-plugin": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0"
  }
}
